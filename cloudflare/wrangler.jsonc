{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secretplay-relay",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_RELAY",
        "class_name": "SecretPlaySessionRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SecretPlaySessionRelay"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
